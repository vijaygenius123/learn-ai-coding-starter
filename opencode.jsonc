{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "body": {
            "temperature": 0.1,
            "reasoning_effort": "none",
          },
        },
      },
    },
  },
  "watcher": {
    "ignore": ["logs/**"],
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 10000 },
    "buffer": 20000,
  },
  "permissions": [
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "deny",
    },
  ],
}
